# geek-book — full book build in Docker: the static website (build/html/) and the
# print PDF (build/book.pdf).
#
# Alpine-based. Node.js runs the engine's own TypeScript through tsx. The PDF is
# typeset by LuaLaTeX (texlive-luatex + texlive-latexextra + texlive-plaingeneric
# for ulem), with poppler's pdfinfo for the page count and rsvg-convert for the
# Mermaid figures. JetBrains Mono comes from an Alpine package and Literata from
# Google Fonts; fontconfig registers both.
#
# compose mounts the book into /workspace and keeps node_modules in a named
# volume, so the container's npm install produces Linux binaries.

FROM node:26-alpine

ARG JUST_VERSION=1.58.0

RUN apk add --no-cache \
        bash curl git su-exec \
        poppler-utils rsvg-convert \
        font-jetbrains-mono-vf fontconfig \
        texlive-luatex texlive-latexextra texlive-plaingeneric \
 && curl -fsSLo /tmp/just.tgz \
        "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
 && tar -C /usr/local/bin -xzf /tmp/just.tgz just \
 && rm /tmp/just.tgz \
 && mkdir -p /usr/share/fonts/literata \
 && curl -fsSLo /usr/share/fonts/literata/Literata.ttf \
        "https://raw.githubusercontent.com/google/fonts/main/ofl/literata/Literata%5Bopsz,wght%5D.ttf" \
 && curl -fsSLo /usr/share/fonts/literata/Literata-Italic.ttf \
        "https://raw.githubusercontent.com/google/fonts/main/ofl/literata/Literata-Italic%5Bopsz,wght%5D.ttf" \
 && fc-cache -f

# Compose mounts node_modules in a named volume (fresh volumes are root-owned);
# the entrypoint chowns it + the npm cache to `node` and then runs as that user,
# so npm install and the build can write without root-owned artifacts on the host.
COPY docker/entrypoint.book /usr/local/bin/entrypoint.book
RUN chmod +x /usr/local/bin/entrypoint.book
ENTRYPOINT ["/usr/local/bin/entrypoint.book"]

WORKDIR /workspace
